#!/usr/bin/env bash
# Everything that must pass before code is shared. Run it from anywhere:
#
#   ./check          format, lint, types, and the full test suite on PostgreSQL
#   ./check --deep   the above, then audit dependencies and prove the tests have teeth
#
# There is no hosted CI; this is the gate. To run it automatically before every push:
#
#   git config core.hooksPath .githooks

set -euo pipefail
cd "$(dirname "$0")"

if ! command -v uv >/dev/null; then
    echo "uv is required: https://docs.astral.sh/uv/ (brew install uv)" >&2
    exit 1
fi

# Without this, tests that need PostgreSQL are skipped when it is not running.
# A gate that passes by skipping the ledger is not a gate.
export REMIT_REQUIRE_POSTGRES=1

step() { printf '\n== %s\n' "$1"; }

step "environment"
# Exactly the versions in uv.lock. Fails if pyproject.toml has changed without a relock.
uv sync --locked --quiet

step "format"
.venv/bin/ruff format --check .

step "lint"
.venv/bin/ruff check .

step "types"
.venv/bin/pyright

step "tests"
.venv/bin/coverage run -m pytest -q

step "coverage"
.venv/bin/coverage report

if [[ "${1:-}" == "--deep" ]]; then
    step "deep: known vulnerabilities in dependencies"
    .venv/bin/pip-audit --skip-editable --progress-spinner off

    step "deep: mutations and repeated races"
    .venv/bin/python checks/deep.py
fi

printf '\nAll checks passed.\n'
